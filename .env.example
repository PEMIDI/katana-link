# Application
PROJECT_NAME=Katana Link
VERSION=0.1.0
ENV=development
ENABLE_DOCS=true
LOG_LEVEL=INFO

# Database - PostgreSQL only
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/katana
SQL_ECHO=false
SQL_POOL_SIZE=5
SQL_MAX_OVERFLOW=10

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

SHORT_DOMAIN=http://localhost:8000